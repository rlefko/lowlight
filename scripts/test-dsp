# SPDX-License-Identifier: GPL-3.0-only
set -euo pipefail
cd "$(dirname "$0")/.."
export TOOLCHAINS=com.apple.dt.toolchain.Xcode
./scripts/toolchain
[[ $# == 0 ]] || { echo 'Usage: scripts/test-dsp' >&2; exit 2; }
mkdir -p .build/DSPTests
flags=(-std=c++17 -ffp-contract=off -Wall -Wextra -Wpedantic -Werror
  -I Packages/LowlightAudio/Sources/CLowlightDSP/include)
for suite in VoiceMixer HarmonicGlue StereoRoom PeakProtector QuietAir SongMix Loudness SongGain SongSource FloatingPoint; do
  sources=("Packages/LowlightAudio/Sources/CLowlightDSP/$suite.cpp" "tests/dsp/${suite}Tests.cpp")
  if [[ "$suite" == FloatingPoint ]]; then
    sources=(Packages/LowlightAudio/Sources/CLowlightDSP/*.cpp tests/dsp/FloatingPointTests.cpp)
  fi
  if [[ "$suite" == QuietAir || "$suite" == SongMix ]]; then
    sources+=(Packages/LowlightAudio/Sources/CLowlightDSP/NumpyRandom.cpp)
  fi
  if [[ "$suite" == SongMix ]]; then
    sources+=(Packages/LowlightAudio/Sources/CLowlightDSP/{QuietAir,HarmonicGlue,StereoRoom}.cpp)
  fi
  if [[ "$suite" == SongSource ]]; then
    sources=(Packages/LowlightAudio/Sources/CLowlightDSP/{VoiceMixer,HarmonicGlue,StereoRoom,SongMix,QuietAir,NumpyRandom}.cpp
      tests/dsp/SongSourceTests.cpp)
  fi
  for mode in optimized sanitized; do
    build_flags=(-O2)
    if [[ "$mode" == sanitized ]]; then
      build_flags=(-O1 -g -fno-omit-frame-pointer -fsanitize=address,undefined -fno-sanitize-recover=all)
    fi
    inputs=("${sources[@]}")
    if [[ "$suite" == SongSource ]]; then
      # Only this test object redirects room calls for deterministic partial-call faults.
      object=".build/DSPTests/SongSource-$mode.o"
      xcrun clang++ "${flags[@]}" "${build_flags[@]}" -Dll_room_process=ll_test_room_process \
        -c Packages/LowlightAudio/Sources/CLowlightDSP/SongSource.cpp -o "$object"
      inputs+=("$object")
    fi
    xcrun clang++ "${flags[@]}" "${build_flags[@]}" "${inputs[@]}" -o ".build/DSPTests/$suite-$mode"
    ".build/DSPTests/$suite-$mode"
  done
done
