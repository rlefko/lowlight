#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
set -euo pipefail
cd "$(dirname "$0")/.."
root="$PWD"
./scripts/toolchain
source config/toolchain.env
export TOOLCHAINS=com.apple.dt.toolchain.Xcode
lint="$root/.tools/swiftlint-$SWIFTLINT_VERSION/swiftlint"
[[ -x "$lint" ]] || { echo 'Run scripts/setup first.' >&2; exit 1; }
mode="${1:-check}"
files=()
case "$mode" in
  staged)
    git diff --cached --check
    snapshot="$(mktemp -d "${TMPDIR:-/tmp}/lowlight-index.XXXXXX")"
    trap 'rm -rf "$snapshot"' EXIT
    git checkout-index --all --prefix="$snapshot/"
    while IFS= read -r -d '' file; do files+=("$snapshot/$file"); done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')
    cd "$snapshot"
    ;;
  check|fix)
    git diff --check
    git diff --cached --check
    while IFS= read -r -d '' file; do [[ ! -f "$file" ]] || files+=("$file"); done < <(git ls-files -z -- '*.swift')
    ;;
  *) echo 'Usage: scripts/quality [check|staged|fix]' >&2; exit 1 ;;
esac
if [[ ${#files[@]} -gt 0 ]]; then
  if [[ "$mode" == fix ]]; then
    xcrun swift format format --in-place --configuration .swift-format "${files[@]}"
  else
    xcrun swift format lint --strict --configuration .swift-format "${files[@]}"
  fi
  "$lint" lint --strict --quiet --no-cache --config .swiftlint.yml "${files[@]}"
fi
